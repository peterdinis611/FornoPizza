@inherits LayoutComponentBase
@inject CartService Cart
@inject IMenuService Oven
@inject IJSRuntime JS
@implements IDisposable

<a class="skip" href="#obsah">Preskočiť na obsah</a>

<div class="shell">
    <header class="mast">
        <a class="brand" href="/">
            <span class="brand-mark">800°</span>
            <span class="brand-name">Forno</span>
        </a>
        <div class="mast-end">
            <nav class="nav">
                <NavLink href="/" Match="NavLinkMatch.All">Pec</NavLink>
                <NavLink href="/menu">Menu</NavLink>
                <NavLink href="/cart" class="nav-cart">
                    Košík
                    @if (Cart.Count > 0)
                    {
                        <span class="cart-count">@Cart.Count</span>
                    }
                </NavLink>
            </nav>
            <button type="button" class="theme-toggle" id="theme-toggle" aria-pressed="false" aria-label="Zapnúť tmavý režim">
                <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M15.5 3.5A8.5 8.5 0 1 0 20.5 14.5 7 7 0 0 1 15.5 3.5Z" />
                </svg>
                <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="12" cy="12" r="4.2" />
                    <path d="M12 3v2.2M12 18.8V21M4.6 4.6l1.6 1.6M17.8 17.8l1.6 1.6M3 12h2.2M18.8 12H21M4.6 19.4l1.6-1.6M17.8 6.2l1.6-1.6" />
                </svg>
            </button>
        </div>
        <div class="heat-rail" aria-hidden="true"><i></i></div>
    </header>

    <main class="stage" id="obsah">
        @Body
    </main>

    <footer class="shop-foot">
        <div class="shop-foot-grid">
            <div>
                <p class="shop-foot-brand">800° Forno</p>
                <p>Neapolská pec v Bardejove. Pizza z múky, dymu a času.</p>
            </div>
            <div>
                <h3>Obchod</h3>
                <a href="/">Dnes v peci</a>
                <a href="/menu">Menu</a>
                <a href="/cart">Košík</a>
                <a href="/#faq">Otázky</a>
            </div>
            <div>
                <h3>Objednávka</h3>
                <p>Denne 11–22</p>
                <p>Od 12 € · zadarmo od 22 €</p>
                <p>Bez účtu · zatiaľ bez platby</p>
                <a href="/#rozvoz">Rozvoz</a>
            </div>
            <div>
                <h3>Alergény</h3>
                <p>Cesto z pšeničnej múky. Marinara je bez syra. Ostatné napíšte do poznámky k objednávke.</p>
            </div>
        </div>
        <div class="colophon">
            <p>Neapolská pec · Bardejov · zatiaľ bez platby a účtov</p>
            <p>800° · otvorené 11–22</p>
        </div>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Niečo sa spálilo v peci.
    <a href="." class="reload">Obnoviť</a>
    <span class="dismiss">×</span>
</div>

@code {
    private bool _cartReady;
    private bool _hydrating;

    protected override void OnInitialized() => Cart.Changed += OnCartChanged;

    private void OnCartChanged() => InvokeAsync(async () =>
    {
        StateHasChanged();
        await PersistCart();
    });

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_cartReady)
        {
            return;
        }

        try
        {
            await HydrateCart();
            _cartReady = true;
            await PersistCart();
        }
        catch (InvalidOperationException)
        {
            /* prerender — JS ešte nie je */
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
            _cartReady = true;
        }
    }

    private async Task HydrateCart()
    {
        _hydrating = true;
        try
        {
            var json = await JS.InvokeAsync<string>("FornoCart.load");
            if (!Cart.IsEmpty)
            {
                return;
            }
            CartSnap[] snaps;
            try
            {
                snaps = System.Text.Json.JsonSerializer.Deserialize<CartSnap[]>(json) ?? [];
            }
            catch (System.Text.Json.JsonException)
            {
                snaps = [];
            }

            var lines = CartMapper.Hydrate(snaps, await Oven.AllAsync());
            if (lines.Count > 0)
            {
                Cart.Replace(lines);
            }
        }
        finally
        {
            _hydrating = false;
        }
    }

    private async Task PersistCart()
    {
        if (_hydrating)
        {
            return;
        }

        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(Cart.Snapshot());
            await JS.InvokeVoidAsync("FornoCart.save", json);
        }
        catch (Exception)
        {
        }
    }

    public void Dispose() => Cart.Changed -= OnCartChanged;
}
