<div class="pie-mark" data-slug="@Slug" aria-hidden="true">
    <svg viewBox="0 0 200 200" focusable="false">
        <defs>
            <radialGradient id="crust-@Gid" cx="46%" cy="40%" r="62%">
                <stop offset="0%" stop-color="#f0c57a" />
                <stop offset="62%" stop-color="#d9a04e" />
                <stop offset="86%" stop-color="#c07a32" />
                <stop offset="100%" stop-color="#8a4e1c" />
            </radialGradient>
            <radialGradient id="sauce-@Gid" cx="48%" cy="46%" r="58%">
                <stop offset="0%" stop-color="#e24a28" />
                <stop offset="55%" stop-color="#c23018" />
                <stop offset="100%" stop-color="#8a160c" />
            </radialGradient>
            <radialGradient id="oil-@Gid" cx="38%" cy="32%" r="40%">
                <stop offset="0%" stop-color="#fff8ee" stop-opacity="0.45" />
                <stop offset="100%" stop-color="#fff8ee" stop-opacity="0" />
            </radialGradient>
        </defs>

        <circle cx="100" cy="100" r="97" fill="url(#crust-@Gid)" />
        <circle cx="100" cy="100" r="96" fill="none" stroke="#6b3a16" stroke-width="2.2" opacity="0.35" />

        <ellipse cx="38" cy="28" rx="7" ry="4" fill="#5a3214" opacity="0.35" transform="rotate(-28 38 28)" />
        <ellipse cx="168" cy="46" rx="8" ry="3.5" fill="#4a2810" opacity="0.4" transform="rotate(22 168 46)" />
        <ellipse cx="22" cy="118" rx="6" ry="3" fill="#5a3214" opacity="0.3" />
        <ellipse cx="154" cy="168" rx="7" ry="3.2" fill="#4a2810" opacity="0.38" transform="rotate(-18 154 168)" />
        <ellipse cx="78" cy="186" rx="6" ry="2.8" fill="#5a3214" opacity="0.32" />
        <ellipse cx="186" cy="108" rx="5" ry="2.6" fill="#4a2810" opacity="0.28" />

        <circle cx="100" cy="100" r="76" fill="url(#sauce-@Gid)" />
        <circle cx="92" cy="94" r="70" fill="#c23018" opacity="0.18" />

        @Mozzarella

        @if (Slug == "diavola")
        {
            @Salami(72, 78, 16)
            @Salami(118, 70, 14)
            @Salami(128, 112, 17)
            @Salami(78, 124, 15)
            @Salami(104, 96, 13)
            @Salami(58, 102, 12)
            <rect x="90" y="64" width="5" height="2" fill="#8a1c0e" transform="rotate(22 92 65)" />
            <rect x="140" y="90" width="4" height="2" fill="#8a1c0e" transform="rotate(-30 142 91)" />
            <rect x="70" y="88" width="5" height="2" fill="#6b1408" transform="rotate(50 72 89)" />
            @Basil(148, 78, 20)
            @Basil(56, 70, -40)
        }
        else if (Slug == "capricciosa")
        {
            <ellipse cx="70" cy="86" rx="18" ry="8" fill="#d8a090" opacity="0.92" transform="rotate(-28 70 86)" />
            <ellipse cx="124" cy="78" rx="16" ry="7" fill="#c48878" opacity="0.9" transform="rotate(18 124 78)" />
            <ellipse cx="108" cy="128" rx="17" ry="7.5" fill="#d8a090" opacity="0.88" transform="rotate(-8 108 128)" />
            <ellipse cx="64" cy="118" rx="11" ry="8" fill="#c4b48a" />
            <ellipse cx="66" cy="116" rx="7" ry="5" fill="#a89068" />
            <ellipse cx="138" cy="118" rx="10" ry="7.5" fill="#c4b48a" />
            <ellipse cx="139" cy="116" rx="6" ry="4.5" fill="#a89068" />
            <circle cx="96" cy="74" r="7" fill="#1c1612" />
            <circle cx="96" cy="74" r="3.2" fill="#3a4a2c" />
            <circle cx="142" cy="92" r="6.2" fill="#1c1612" />
            <circle cx="142" cy="92" r="2.8" fill="#3a4a2c" />
            <circle cx="80" cy="138" r="6.5" fill="#1c1612" />
            <circle cx="80" cy="138" r="3" fill="#3a4a2c" />
            <path d="M118 96c6-10 16-12 18-4-8 4-12 10-18 4z" fill="#6b7a48" />
            @Basil(52, 96, -18)
            @Basil(150, 70, 30)
        }
        else
        {
            @Basil(64, 72, -24)
            @Basil(128, 64, 18)
            @Basil(146, 112, 50)
            @Basil(78, 132, -8)
            @Basil(108, 96, 12)
        }

        <circle cx="100" cy="100" r="76" fill="url(#oil-@Gid)" />

        @if (Has("kukurica"))
        {
            <g class="extra-drop @FreshCls("kukurica")" data-extra="kukurica">
                <g class="extra-bit"><ellipse cx="68" cy="72" rx="5.2" ry="3.4" fill="#f0d45a" transform="rotate(-28 68 72)" /></g>
                <g class="extra-bit"><ellipse cx="88" cy="90" rx="5.6" ry="3.6" fill="#e8c04a" transform="rotate(18 88 90)" /></g>
                <g class="extra-bit"><ellipse cx="118" cy="74" rx="5" ry="3.3" fill="#f4dc6a" transform="rotate(-12 118 74)" /></g>
                <g class="extra-bit"><ellipse cx="108" cy="116" rx="5.4" ry="3.5" fill="#e8c04a" transform="rotate(32 108 116)" /></g>
                <g class="extra-bit"><ellipse cx="76" cy="126" rx="5.1" ry="3.2" fill="#d4a832" transform="rotate(-8 76 126)" /></g>
                <g class="extra-bit"><ellipse cx="132" cy="108" rx="4.8" ry="3.1" fill="#f0d45a" transform="rotate(22 132 108)" /></g>
                <g class="extra-bit"><ellipse cx="96" cy="104" rx="4.6" ry="3" fill="#f4dc6a" transform="rotate(-40 96 104)" /></g>
            </g>
        }
        @if (Has("syr"))
        {
            <g class="extra-drop @FreshCls("syr")" data-extra="syr">
                <g class="extra-bit"><ellipse cx="64" cy="88" rx="16" ry="11" fill="#fff8ee" opacity="0.92" transform="rotate(-22 64 88)" /></g>
                <g class="extra-bit"><ellipse cx="128" cy="92" rx="14" ry="10" fill="#fff6de" opacity="0.9" transform="rotate(14 128 92)" /></g>
                <g class="extra-bit"><ellipse cx="96" cy="128" rx="13" ry="9" fill="#f4e4c4" opacity="0.88" transform="rotate(-6 96 128)" /></g>
            </g>
        }
        @if (Has("olivy"))
        {
            <g class="extra-drop @FreshCls("olivy")" data-extra="olivy">
                <g class="extra-bit"><circle cx="62" cy="78" r="6.4" fill="#1c1612" /><circle cx="62" cy="78" r="2.8" fill="#3a4a2c" /></g>
                <g class="extra-bit"><circle cx="124" cy="70" r="5.8" fill="#1c1612" /><circle cx="124" cy="70" r="2.5" fill="#3a4a2c" /></g>
                <g class="extra-bit"><circle cx="138" cy="122" r="6" fill="#1c1612" /><circle cx="138" cy="122" r="2.6" fill="#3a4a2c" /></g>
                <g class="extra-bit"><circle cx="82" cy="136" r="5.5" fill="#1c1612" /><circle cx="82" cy="136" r="2.4" fill="#3a4a2c" /></g>
            </g>
        }
        @if (Has("chilli"))
        {
            <g class="extra-drop @FreshCls("chilli")" data-extra="chilli">
                <g class="extra-bit"><rect x="70" y="64" width="9" height="2.4" fill="#c23018" transform="rotate(28 74 65)" /></g>
                <g class="extra-bit"><rect x="118" y="78" width="8" height="2.2" fill="#a82812" transform="rotate(-36 122 79)" /></g>
                <g class="extra-bit"><rect x="92" y="118" width="10" height="2.5" fill="#e4452c" transform="rotate(18 97 119)" /></g>
                <g class="extra-bit"><rect x="136" y="108" width="7.5" height="2" fill="#c23018" transform="rotate(-50 140 109)" /></g>
                <g class="extra-bit"><rect x="64" y="112" width="8.5" height="2.2" fill="#8a160c" transform="rotate(42 68 113)" /></g>
            </g>
        }
        @if (Has("sunka"))
        {
            <g class="extra-drop @FreshCls("sunka")" data-extra="sunka">
                <g class="extra-bit"><ellipse cx="74" cy="80" rx="16" ry="7" fill="#d8a090" opacity="0.94" transform="rotate(-26 74 80)" /></g>
                <g class="extra-bit"><ellipse cx="126" cy="96" rx="15" ry="6.5" fill="#c48878" opacity="0.92" transform="rotate(18 126 96)" /></g>
                <g class="extra-bit"><ellipse cx="98" cy="130" rx="14" ry="6.2" fill="#d8a090" opacity="0.9" transform="rotate(-8 98 130)" /></g>
            </g>
        }
        @if (Has("sampiony"))
        {
            <g class="extra-drop @FreshCls("sampiony")" data-extra="sampiony">
                <g class="extra-bit"><ellipse cx="70" cy="96" rx="10" ry="7.5" fill="#c4b48a" /><ellipse cx="70" cy="94" rx="6" ry="4.2" fill="#a89068" /></g>
                <g class="extra-bit"><ellipse cx="122" cy="78" rx="9" ry="7" fill="#d0c09a" /><ellipse cx="122" cy="76" rx="5.4" ry="3.8" fill="#a89068" /></g>
                <g class="extra-bit"><ellipse cx="108" cy="128" rx="9.5" ry="7.2" fill="#c4b48a" /><ellipse cx="108" cy="126" rx="5.6" ry="4" fill="#8a7858" /></g>
            </g>
        }
        @if (Has("cesnak"))
        {
            <g class="extra-drop @FreshCls("cesnak")" data-extra="cesnak">
                <g class="extra-bit"><ellipse cx="80" cy="70" rx="8" ry="3.2" fill="#efe6c8" transform="rotate(-18 80 70)" /></g>
                <g class="extra-bit"><ellipse cx="128" cy="88" rx="7.5" ry="3" fill="#fff8ee" transform="rotate(24 128 88)" /></g>
                <g class="extra-bit"><ellipse cx="96" cy="124" rx="8.2" ry="3.1" fill="#efe6c8" transform="rotate(-8 96 124)" /></g>
                <g class="extra-bit"><ellipse cx="60" cy="110" rx="7" ry="2.8" fill="#e8dcc0" transform="rotate(40 60 110)" /></g>
            </g>
        }
        @if (Has("bazalka"))
        {
            <g class="extra-drop @FreshCls("bazalka")" data-extra="bazalka">
                <g class="extra-bit">@Basil(58, 86, -22)</g>
                <g class="extra-bit">@Basil(140, 74, 28)</g>
                <g class="extra-bit">@Basil(118, 132, 8)</g>
            </g>
        }
        @if (Has("cibula"))
        {
            <g class="extra-drop @FreshCls("cibula")" data-extra="cibula">
                <g class="extra-bit"><path d="M62 92c8-10 22-8 24 2-10 2-18 6-24-2z" fill="#dcc4d0" opacity="0.92" /></g>
                <g class="extra-bit"><path d="M118 70c10-8 22-4 22 8-12 0-18 4-22-8z" fill="#c8a8b8" opacity="0.9" /></g>
                <g class="extra-bit"><path d="M96 128c9-9 20-6 22 4-11 1-18 6-22-4z" fill="#e8d4dc" opacity="0.9" /></g>
            </g>
        }
        @if (Has("gorgonzola"))
        {
            <g class="extra-drop @FreshCls("gorgonzola")" data-extra="gorgonzola">
                <g class="extra-bit"><ellipse cx="72" cy="92" rx="13" ry="8" fill="#d8e4e8" opacity="0.92" transform="rotate(-16 72 92)" /></g>
                <g class="extra-bit"><ellipse cx="126" cy="108" rx="11" ry="7" fill="#9bb8c4" opacity="0.78" transform="rotate(12 126 108)" /></g>
                <g class="extra-bit"><ellipse cx="100" cy="70" rx="9" ry="6" fill="#c8d8dc" opacity="0.88" transform="rotate(-28 100 70)" /></g>
            </g>
        }
        @if (Has("articoky"))
        {
            <g class="extra-drop @FreshCls("articoky")" data-extra="articoky">
                <g class="extra-bit"><ellipse cx="68" cy="100" rx="11" ry="8" fill="#c4b48a" /><ellipse cx="68" cy="98" rx="7" ry="5" fill="#a89068" /></g>
                <g class="extra-bit"><ellipse cx="130" cy="88" rx="10" ry="7.5" fill="#d0c09a" /><ellipse cx="130" cy="86" rx="6.2" ry="4.5" fill="#a89068" /></g>
                <g class="extra-bit"><ellipse cx="102" cy="132" rx="10.5" ry="7.8" fill="#c4b48a" /><ellipse cx="102" cy="130" rx="6.4" ry="4.6" fill="#8a7858" /></g>
            </g>
        }
        @if (Has("med"))
        {
            <g class="extra-drop @FreshCls("med")" data-extra="med">
                <g class="extra-bit"><path d="M78 68c2 8 1 14-2 18" fill="none" stroke="#e8b86a" stroke-width="2.2" stroke-linecap="round" /></g>
                <g class="extra-bit"><path d="M124 76c1 9 0 14-3 17" fill="none" stroke="#d49a3a" stroke-width="2" stroke-linecap="round" /></g>
                <g class="extra-bit"><circle cx="92" cy="118" r="3.2" fill="#e8b86a" opacity="0.9" /></g>
                <g class="extra-bit"><circle cx="136" cy="112" r="2.6" fill="#f0d45a" opacity="0.85" /></g>
            </g>
        }
    </svg>
</div>

@code {
    [Parameter] public string Slug { get; set; } = "margherita";
    [Parameter] public string MarkId { get; set; } = "pie";
    [Parameter] public IReadOnlyList<string> Extras { get; set; } = [];
    [Parameter] public string? FreshId { get; set; }

    private string Gid => MarkId;

    private RenderFragment Mozzarella => @<text>
        <ellipse cx="78" cy="86" rx="24" ry="17" fill="#fff6de" opacity="0.94" transform="rotate(-18 78 86)" />
        <ellipse cx="118" cy="80" rx="20" ry="15" fill="#f4e4c4" opacity="0.9" transform="rotate(12 118 80)" />
        <ellipse cx="124" cy="118" rx="22" ry="16" fill="#fff8ee" opacity="0.88" transform="rotate(-8 124 118)" />
        <ellipse cx="82" cy="122" rx="18" ry="13" fill="#f0dcb0" opacity="0.9" transform="rotate(16 82 122)" />
        <ellipse cx="100" cy="100" rx="16" ry="12" fill="#fff6de" opacity="0.72" />
        <ellipse cx="58" cy="100" rx="12" ry="9" fill="#fff8ee" opacity="0.8" transform="rotate(-30 58 100)" />
    </text>;

    private RenderFragment Salami(double cx, double cy, double r) => @<text>
        <circle cx="@cx" cy="@cy" r="@r" fill="#9a2418" />
        <circle cx="@cx" cy="@cy" r="@(r * 0.62)" fill="#c44832" opacity="0.9" />
        <circle cx="@(cx - r * 0.22)" cy="@(cy - r * 0.18)" r="@(r * 0.16)" fill="#6b140c" opacity="0.45" />
        <circle cx="@(cx + r * 0.18)" cy="@(cy + r * 0.2)" r="@(r * 0.12)" fill="#6b140c" opacity="0.35" />
    </text>;

    private RenderFragment Basil(double cx, double cy, double rot) => @<text>
        <g transform="translate(@cx @cy) rotate(@rot)">
            <path d="M0 0c8-16 22-20 28-6-10 6-20 12-28 6z" fill="#3a4a2c" />
            <path d="M4 -2c6-8 14-10 18-3" fill="none" stroke="#24301c" stroke-width="0.8" opacity="0.55" />
        </g>
    </text>;

    private bool Has(string id) =>
        Extras.Contains(id, StringComparer.OrdinalIgnoreCase);

    private string FreshCls(string id) =>
        string.Equals(id, FreshId, StringComparison.OrdinalIgnoreCase) ? "is-fresh" : "";
}
