@page "/menu"
@inject NavigationManager Nav
@inject IMenuService Oven
@inject CartService Cart
@inject IJSRuntime JS
@implements IDisposable
@implements IAsyncDisposable

<PageTitle>Menu — 800° Forno</PageTitle>
<Seo Title="Menu — 800° Forno"
     Description="Šesť listov z neapolskej pece v Bardejove. Margherita, Marinara, Diavola, Quattro formaggi, Prosciutto e funghi, Capricciosa."
     Path="/menu"
     JsonLd="@MenuJson" />

<div class="kiln-ledger" @ref="_root">
    <header class="ledger-mast">
        <p class="eyebrow ledger-copy">Šesť listov, jedna pec</p>
        <h1 class="ledger-title" aria-label="Menu">
            <span class="hero-title-line">
                @foreach (var letter in "MENU")
                {
                    <span class="char" aria-hidden="true">@letter</span>
                }
            </span>
        </h1>
        <p class="lede ledger-copy">Listy, ktoré pec práve spečie. Hľadajte, filtrujte, dajte do košíka — kôra ide von ešte horúca.</p>
        <p class="ledger-count">
            <strong data-count="@Visible.Count">@Visible.Count</strong>
            @(Visible.Count == 1 ? "list v peci" : "listov v peci")
            @if (IsFiltered)
            {
                <span>z @All.Count</span>
            }
        </p>
    </header>

    <div class="ledger-tools">
        <OvenSearch @ref="_search"
                    @key="_searchKey"
                    Items="All"
                    Tag="@ActiveTag"
                    InitialQuery="@SearchQuery"
                    SyncUrl="true"
                    SlugsChanged="OnSearchSlugs" />
        <nav class="tag-row menu-tags" aria-label="Kategórie">
            <button type="button" class="@TagClass(null)" @onclick="() => SetTag(null)">Všetko</button>
            <button type="button" class="@TagClass("klasika")" @onclick='() => SetTag("klasika")'>Klasika</button>
            <button type="button" class="@TagClass("pikant")" @onclick='() => SetTag("pikant")'>Pikantné</button>
            <button type="button" class="@TagClass("bez-masa")" @onclick='() => SetTag("bez-masa")'>Bez mäsa</button>
            <button type="button" class="@TagClass("syry")" @onclick='() => SetTag("syry")'>Syry</button>
        </nav>
    </div>

    @if (IsFiltered)
    {
        <p class="ledger-filter">
            @if (!string.IsNullOrWhiteSpace(SearchQuery))
            {
                <span>Hľadanie: @SearchQuery</span>
            }
            @if (!string.IsNullOrWhiteSpace(ActiveTag))
            {
                <span>Kategória: @TagLabel</span>
            }
            <button type="button" class="ledger-filter-clear" @onclick="ClearFilters">Zobraziť všetko</button>
        </p>
    }

    @if (!Visible.Any())
    {
        <p class="empty ledger-empty">V peci to nenašli. <a href="/menu">Celé menu</a></p>
    }
    else
    {
        <ol class="peel-board">
            @foreach (var (pizza, i) in Visible.Select((p, i) => (p, i)))
            {
                <li class="@(i == 0 ? "peel-lead" : "peel-row")" data-tilt>
                    <a href="/menu/@pizza.Slug">
                        @if (i != 0)
                        {
                            <span class="index">@((i + 1).ToString("00"))</span>
                        }
                        <PizzaMark Slug="@pizza.Slug" MarkId="@($"menu-{pizza.Slug}")" />
                        <span class="row-copy">
                            @if (i == 0)
                            {
                                <span class="fire-stamp">List dňa</span>
                            }
                            <strong>@pizza.Name</strong>
                            <em>@pizza.Tagline</em>
                            @if (i == 0)
                            {
                                <span class="ingredients">@pizza.Ingredients</span>
                            }
                            <span class="peel-stamps">
                                @foreach (var stamp in Stamps(pizza))
                                {
                                    <i>@stamp</i>
                                }
                            </span>
                        </span>
                        <span class="price">@pizza.Price.ToString("N2") €</span>
                    </a>
                    <button class="btn tomato peel-add" type="button" data-magnetic @onclick="() => Add(pizza)">
                        @(InCart(pizza) ? "Pridať ďalšiu" : "Do košíka")
                    </button>
                </li>
            }
        </ol>
    }
</div>

@code {
    [SupplyParameterFromQuery]
    public string? Q { get; set; }

    [SupplyParameterFromQuery]
    public string? Tag { get; set; }

    private ElementReference _root;
    private OvenSearch? _search;
    private bool _mounted;
    private string _urlKey = "";
    private int _searchKey;
    private IReadOnlyList<PizzaItem> All { get; set; } = [];
    private string SearchQuery { get; set; } = "";
    private string? ActiveTag { get; set; }
    private IReadOnlyList<string> SearchSlugs { get; set; } = [];

    private IReadOnlyList<PizzaItem> Visible
    {
        get
        {
            if (SearchSlugs.Count == 0)
            {
                return [];
            }

            var order = SearchSlugs
                .Select((slug, index) => (slug, index))
                .ToDictionary(pair => pair.slug, pair => pair.index, StringComparer.OrdinalIgnoreCase);

            return All
                .Where(pizza => order.ContainsKey(pizza.Slug))
                .OrderBy(pizza => order[pizza.Slug])
                .ToList();
        }
    }

    private bool IsFiltered =>
        !string.IsNullOrWhiteSpace(SearchQuery) || !string.IsNullOrWhiteSpace(ActiveTag);

    private string MenuJson
    {
        get
        {
            var root = Nav.BaseUri.TrimEnd('/');
            var items = string.Join(",", All.Select((p, i) =>
                $$"""{"@type":"ListItem","position":{{i + 1}},"url":"{{root}}/menu/{{p.Slug}}","name":"{{p.Name}}"}"""));
            return $$"""{"@context":"https://schema.org","@type":"ItemList","name":"Menu 800° Forno","itemListElement":[{{items}}]}""";
        }
    }

    private string TagLabel => ActiveTag switch
    {
        "klasika" => "Klasika",
        "pikant" => "Pikantné",
        "bez-masa" => "Bez mäsa",
        "syry" => "Syry",
        _ => ActiveTag ?? ""
    };

    protected override void OnInitialized() => Cart.Changed += OnCartChanged;

    protected override async Task OnInitializedAsync()
    {
        All = await Oven.AllAsync();
        SyncFromUrl();
    }

    protected override void OnParametersSet()
    {
        var key = $"{Q}|{Tag}";
        if (key == _urlKey || All.Count == 0)
        {
            return;
        }

        SyncFromUrl();
    }

    private void SyncFromUrl()
    {
        SearchQuery = Q ?? "";
        ActiveTag = string.IsNullOrWhiteSpace(Tag) ? null : Tag;
        _urlKey = $"{SearchQuery}|{ActiveTag}";
        SearchSlugs = MenuFilter.Apply(All, SearchQuery, ActiveTag)
            .Select(pizza => pizza.Slug)
            .ToList();
    }

    private Task OnSearchSlugs(IReadOnlyList<string> slugs)
    {
        SearchSlugs = slugs;
        SearchQuery = _search?.CurrentQuery ?? SearchQuery;
        return InvokeAsync(StateHasChanged);
    }

    private async Task SetTag(string? tag)
    {
        var next = string.IsNullOrWhiteSpace(tag) ? null : tag;
        if (string.Equals(ActiveTag, next, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        ActiveTag = next;
        _urlKey = $"{SearchQuery}|{ActiveTag}";
        await PushFilterUrlAsync();
    }

    private async Task ClearFilters()
    {
        ActiveTag = null;
        SearchQuery = "";
        _urlKey = "|";
        _searchKey++;
        await PushFilterUrlAsync();
        SearchSlugs = All.Select(pizza => pizza.Slug).ToList();
        await InvokeAsync(StateHasChanged);
    }

    private async Task PushFilterUrlAsync()
    {
        var url = BuildFilterUrl(ActiveTag, SearchQuery);
        try
        {
            await JS.InvokeVoidAsync("FornoNav.replace", url);
        }
        catch (Exception)
        {
            Nav.NavigateTo(url, replace: true);
        }
    }

    private string? TagClass(string? tag) =>
        string.Equals(ActiveTag, tag, StringComparison.OrdinalIgnoreCase)
        || (tag is null && string.IsNullOrWhiteSpace(ActiveTag))
            ? "is-on"
            : null;

    private static string BuildFilterUrl(string? tag, string query)
    {
        var q = query.Trim();
        if (string.IsNullOrEmpty(tag) && string.IsNullOrEmpty(q))
        {
            return "/menu";
        }

        if (string.IsNullOrEmpty(tag))
        {
            return $"/menu?q={Uri.EscapeDataString(q)}";
        }

        if (string.IsNullOrEmpty(q))
        {
            return $"/menu?tag={tag}";
        }

        return $"/menu?tag={tag}&q={Uri.EscapeDataString(q)}";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender && _mounted)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("FornoMotion.mountMenu", _root, firstRender);
            _mounted = true;
        }
        catch (Exception)
        {
        }
    }

    private static IEnumerable<string> Stamps(PizzaItem pizza)
    {
        foreach (var tag in pizza.Tags.Split(' ', StringSplitOptions.RemoveEmptyEntries))
        {
            yield return tag switch
            {
                "klasika" => "Klasika",
                "pikant" => "Pikant",
                "bez-masa" => "Bez mäsa",
                "syry" => "Syry",
                _ => tag
            };
        }
    }

    private bool InCart(PizzaItem pizza) =>
        Cart.Lines.Any(line => line.Pizza.Slug == pizza.Slug);

    private void Add(PizzaItem pizza) => Cart.Add(pizza);

    private void OnCartChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Cart.Changed -= OnCartChanged;

    public async ValueTask DisposeAsync()
    {
        if (!_mounted)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("FornoMotion.unmount");
        }
        catch (Exception)
        {
        }
    }
}
