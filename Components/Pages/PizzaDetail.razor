@page "/menu/{Slug}"
@inject CartService Cart
@inject MenuService Menu
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (!_ready)
{
}
else if (Pizza is null)
{
    <PageTitle>404 — list v peci nie je — Forno</PageTitle>
    <Seo Title="404 — list v peci nie je — Forno"
         Description="Tento list v peci nie je. Vráťte sa k menu 800° Forno v Bardejove."
         NoIndex="true" />
    <KilnFault Code="404" />
}
else
{
    <PageTitle>@Pizza.Name — 800° Forno</PageTitle>
    <Seo Title="@($"{Pizza.Name} — 800° Forno")"
         Description="@Pizza.Description"
         Path="@($"/menu/{Pizza.Slug}")"
         JsonLd="@PizzaJson" />

    <article class="leaf" @ref="_root">
        <nav class="leaf-crumb leaf-fade">
            <a href="/menu">Menu</a>
            <span aria-hidden="true">/</span>
            <span>@Pizza.Name</span>
        </nav>

        <section class="leaf-hero">
            <div class="leaf-stage">
                <div class="oven-mouth leaf-kiln" data-tilt>
                    <span class="ember" style="--x: 18%; --delay: 0s"></span>
                    <span class="ember" style="--x: 42%; --delay: 1.1s"></span>
                    <span class="ember" style="--x: 61%; --delay: 0.4s"></span>
                    <span class="ember" style="--x: 77%; --delay: 1.8s"></span>
                    <span class="ember" style="--x: 33%; --delay: 2.4s"></span>
                    <div class="oven-soot"></div>
                    <svg class="heat-ring" viewBox="0 0 200 200" aria-hidden="true">
                        <defs>
                            <path id="leaf-heat-@Pizza.Slug" d="M100,100 m-90,0 a90,90 0 1,1 180,0 a90,90 0 1,1 -180,0" fill="none" />
                        </defs>
                        <text>
                            <textPath href="#leaf-heat-@Pizza.Slug">800° · @Pizza.Name.ToUpperInvariant() · 90s · 800° · @Pizza.Name.ToUpperInvariant() · 90s · </textPath>
                        </text>
                    </svg>
                    <div class="oven-pie">
                        <PizzaMark Slug="@Pizza.Slug" MarkId="@($"leaf-{Pizza.Slug}")" Extras="ShownExtras" FreshId="@_freshExtra" />
                    </div>
                    <div class="kiln-door kiln-door-a" aria-hidden="true"></div>
                    <div class="kiln-door kiln-door-b" aria-hidden="true"></div>
                </div>
                <aside class="leaf-slip leaf-fade">
                    <div class="leaf-slip-card">
                        <p>Pec · Bardejov</p>
                        <strong>List @Leaf.Number</strong>
                        <dl>
                            <div>
                                <dt>Hmotnosť</dt>
                                <dd>@Leaf.Weight</dd>
                            </div>
                            <div>
                                <dt>Múka</dt>
                                <dd>@Leaf.Flour</dd>
                            </div>
                            <div>
                                <dt>Drevo</dt>
                                <dd>@Leaf.Wood</dd>
                            </div>
                        </dl>
                    </div>
                </aside>
            </div>

            <div class="leaf-copy">
                <div class="leaf-meta leaf-fade">
                    <p class="eyebrow">@Pizza.Tagline</p>
                    <div class="peel-stamps">
                        @foreach (var stamp in Stamps(Pizza))
                        {
                            <i>@stamp</i>
                        }
                    </div>
                </div>
                <h1 class="leaf-title" aria-label="@Pizza.Name">
                    <span class="hero-title-line leaf-title-line">
                        @foreach (var letter in Pizza.Name.ToUpperInvariant())
                        {
                            if (letter == ' ')
                            {
                                <span class="char char-gap" aria-hidden="true">&nbsp;</span>
                            }
                            else
                            {
                                <span class="char" aria-hidden="true">@letter</span>
                            }
                        }
                    </span>
                </h1>
                <p class="lede leaf-fade">@Pizza.Description</p>
                <ul class="leaf-ings leaf-fade">
                    @foreach (var part in Pizza.Ingredients.Split("·", StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries))
                    {
                        <li>@part</li>
                    }
                    @foreach (var extra in PickedExtras)
                    {
                        <li class="is-extra">+ @extra.Name</li>
                    }
                </ul>
                <dl class="leaf-facts leaf-fade">
                    <div>
                        <dt>@Leaf.Heat</dt>
                        <dd>pec</dd>
                    </div>
                    <div>
                        <dt>@Leaf.Time</dt>
                        <dd>v ohni</dd>
                    </div>
                    <div>
                        <dt>@Leaf.Dough</dt>
                        <dd>kvasenie</dd>
                    </div>
                    <div>
                        <dt>@Leaf.Diameter</dt>
                        <dd>list</dd>
                    </div>
                </dl>
                <div class="leaf-act leaf-fade">
                    <p class="detail-price">
                        @UnitPrice.ToString("N2") €
                        @if (Quantity > 1)
                        {
                            <span class="leaf-sum">@Quantity × = @LineTotal.ToString("N2") €</span>
                        }
                    </p>
                    <div class="leaf-buy" data-leaf-buy>
                        <div class="qty-step" aria-label="Kusy">
                            <button type="button" @onclick="Less" aria-label="Menej">−</button>
                            <span>@Quantity</span>
                            <button type="button" @onclick="More" aria-label="Viac">+</button>
                        </div>
                        <button class="btn" type="button" @onclick="OpenMise">
                            Ešte na list
                            @if (ExtraIds.Count > 0)
                            {
                                <span class="leaf-mise-count">@ExtraIds.Count</span>
                            }
                        </button>
                        <button class="btn tomato" type="button" data-magnetic @onclick="Add">
                            @(InCart ? "Pridať ďalšiu" : "Do košíka")
                        </button>
                    </div>
                    <a class="leaf-back" href="/menu">Späť k listom</a>
                </div>
                @if (JustAdded)
                {
                    <p class="leaf-notice" aria-live="polite">
                        V košíku. <a href="/kosik">Otvoriť košík</a>
                    </p>
                }
                <p class="leaf-allergy leaf-fade">Alergény: @AllergyLine</p>
            </div>
        </section>

        <blockquote class="leaf-quote" data-scroll>
            <p>@Leaf.Quote</p>
            <footer>Zápis z pece · list @Leaf.Number</footer>
        </blockquote>

        @if (Leaf.Layers.Count > 0)
        {
            <section class="leaf-layers">
                <header class="spread-head" data-scroll>
                    <p class="eyebrow">Na liste</p>
                    <h2>Zloženie</h2>
                </header>
                <ol>
                    @foreach (var (layer, i) in Leaf.Layers.Select((l, i) => (l, i)))
                    {
                        <li class="leaf-layer" data-scroll>
                            <span>@((i + 1).ToString("00"))</span>
                            <strong>@layer.Name</strong>
                            <em>@layer.Note</em>
                        </li>
                    }
                </ol>
            </section>
        }

        <section class="leaf-notes">
            <div class="leaf-note" data-scroll>
                <span>01</span>
                <strong>Ako pecie</strong>
                <em>@Leaf.BakeNote</em>
            </div>
            <div class="leaf-note" data-scroll>
                <span>02</span>
                <strong>K stolu</strong>
                <em>@Leaf.PairsWith</em>
            </div>
            <div class="leaf-note" data-scroll>
                <span>03</span>
                <strong>Rozvoz</strong>
                <em>Bardejov 30–40 min. Od 12 €, zadarmo od 22 €. Výdaj pri peci 15–20 min.</em>
            </div>
        </section>

        @if (Others.Count > 0)
        {
            <section class="leaf-others">
                <header class="spread-head" data-scroll>
                    <p class="eyebrow">Ešte v peci</p>
                    <h2>Ďalšie listy</h2>
                    <a href="/menu">Celé menu →</a>
                </header>
                <ol class="peel-board leaf-others-board">
                    @foreach (var (pizza, i) in Others.Select((p, i) => (p, i)))
                    {
                        <li class="peel-row" data-scroll>
                            <a href="/menu/@pizza.Slug">
                                <span class="index">@((i + 1).ToString("00"))</span>
                                <PizzaMark Slug="@pizza.Slug" MarkId="@($"sib-{pizza.Slug}")" />
                                <span class="row-copy">
                                    <strong>@pizza.Name</strong>
                                    <em>@pizza.Tagline</em>
                                </span>
                                <span class="price">@pizza.Price.ToString("N2") €</span>
                            </a>
                        </li>
                    }
                </ol>
                @if (Prev is not null || Next is not null)
                {
                    <nav class="leaf-turn" data-scroll>
                        @if (Prev is not null)
                        {
                            <a href="/menu/@Prev.Slug">← @Prev.Name</a>
                        }
                        else
                        {
                            <span></span>
                        }
                        @if (Next is not null)
                        {
                            <a href="/menu/@Next.Slug">@Next.Name →</a>
                        }
                    </nav>
                }
            </section>
        }

        <aside class="leaf-dock" aria-label="Rýchly nákup">
            <div class="leaf-dock-copy">
                <strong>@Pizza.Name</strong>
                <span>@Leaf.Diameter · @Leaf.Heat · @Leaf.Time</span>
            </div>
            <p class="leaf-dock-price">@UnitPrice.ToString("N2") €</p>
            <div class="qty-step" aria-label="Kusy">
                <button type="button" @onclick="Less" aria-label="Menej">−</button>
                <span>@Quantity</span>
                <button type="button" @onclick="More" aria-label="Viac">+</button>
            </div>
            <button class="btn tomato" type="button" data-magnetic @onclick="Add">
                @(InCart ? "Ďalšia" : "Do košíka")
            </button>
        </aside>

        @if (MiseOpen)
        {
            <div class="mise-layer" role="dialog" aria-modal="true" aria-labelledby="mise-title">
                <button type="button" class="mise-ghost" @onclick="CloseMise" aria-label="Zavrieť prílohy"></button>
                <aside class="mise-peel">
                    <header class="mise-head">
                        <p class="eyebrow">Prílohy</p>
                        <h2 id="mise-title">Čo ešte unesie pec</h2>
                        <button class="mise-close" type="button" @onclick="CloseMise" aria-label="Zavrieť">×</button>
                    </header>
                    <p class="mise-lede">Kliknite — vec dopadne na list. Pec unesie ešte @(RemainExtras == 1 ? "1 vec" : $"{RemainExtras} vecí").</p>
                    <ol class="mise-board">
                        @foreach (var extra in OvenExtras.All)
                        {
                            var on = HasExtra(extra.Id);
                            <li class="@(on ? "is-on" : null)">
                                <button type="button" disabled="@(!on && ExtraIds.Count >= OvenExtras.MaxOnLeaf)" @onclick="() => ToggleExtra(extra.Id)">
                                    <span class="mise-swatch" style="--swatch: @extra.Swatch"></span>
                                    <span class="mise-copy">
                                        <strong>@extra.Name</strong>
                                        <em>@extra.Note</em>
                                    </span>
                                    <span class="mise-price">+ @extra.Price.ToString("N2") €</span>
                                    <span class="mise-flag">@(on ? "Na liste" : "Pridať")</span>
                                </button>
                            </li>
                        }
                    </ol>
                </aside>
            </div>
        }
    </article>
}

@code {
    [Parameter]
    public string Slug { get; set; } = "";

    [CascadingParameter]
    private HttpContext? Http { get; set; }

    private ElementReference _root;
    private PizzaItem? Pizza { get; set; }
    private PizzaLeaf Leaf { get; set; } = PizzaLeaves.For("");
    private IReadOnlyList<PizzaItem> Others { get; set; } = [];
    private PizzaItem? Prev { get; set; }
    private PizzaItem? Next { get; set; }
    private int Quantity { get; set; } = 1;
    private readonly List<string> ExtraIds = [];
    private string? _freshExtra;
    private bool _ready;
    private bool _mounted;
    private bool _restoreLeaf;
    private string _mountedSlug = "";
    private string _paramSlug = "";
    private bool JustAdded { get; set; }
    private bool MiseOpen { get; set; }

    private string[] ShownExtras => ExtraIds.ToArray();

    private decimal ExtraTotal => OvenExtras.Sum(ExtraIds);

    private decimal UnitPrice => Pizza is null ? 0 : Pizza.Price + ExtraTotal;

    private decimal LineTotal => UnitPrice * Quantity;

    private int RemainExtras => Math.Max(0, OvenExtras.MaxOnLeaf - ExtraIds.Count);

    private IEnumerable<OvenExtra> PickedExtras =>
        ExtraIds.Select(OvenExtras.Find).OfType<OvenExtra>();

    private string AllergyLine
    {
        get
        {
            var extra = OvenExtras.Allergens(ExtraIds);
            return string.IsNullOrWhiteSpace(extra) ? Leaf.Allergens : $"{Leaf.Allergens} · {extra}";
        }
    }

    private bool InCart =>
        Pizza is not null && Cart.Lines.Any(line =>
            line.Pizza.Slug == Pizza.Slug && OvenExtras.Same(line.ExtraIds, ExtraIds));

    private string PizzaJson
    {
        get
        {
            if (Pizza is null)
            {
                return "";
            }

            var url = $"{Nav.BaseUri.TrimEnd('/')}/menu/{Pizza.Slug}";
            var price = Pizza.Price.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);
            var desc = Pizza.Description.Replace("\\", "\\\\").Replace("\"", "\\\"");
            return "{\"@context\":\"https://schema.org\",\"@type\":\"MenuItem\",\"name\":\"" + Pizza.Name
                + "\",\"description\":\"" + desc
                + "\",\"url\":\"" + url
                + "\",\"offers\":{\"@type\":\"Offer\",\"price\":\"" + price
                + "\",\"priceCurrency\":\"EUR\",\"availability\":\"https://schema.org/InStock\"}}";
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        var slugChanged = !Slug.Equals(_paramSlug, StringComparison.OrdinalIgnoreCase);
        if (slugChanged)
        {
            JustAdded = false;
            Quantity = 1;
            ExtraIds.Clear();
            _freshExtra = null;
            MiseOpen = false;
            _restoreLeaf = true;
            _paramSlug = Slug;
            _mounted = false;
        }

        Pizza = await Menu.FindAsync(Slug);
        Leaf = PizzaLeaves.For(Slug);

        var all = await Menu.AllAsync();
        Others = Pizza is null
            ? []
            : all
                .Where(p => !p.Slug.Equals(Slug, StringComparison.OrdinalIgnoreCase))
                .OrderByDescending(p => SharesTags(p, Pizza))
                .ThenByDescending(p => p.Featured)
                .Take(3)
                .ToList();

        var index = -1;
        for (var i = 0; i < all.Count; i++)
        {
            if (all[i].Slug.Equals(Slug, StringComparison.OrdinalIgnoreCase))
            {
                index = i;
                break;
            }
        }
        Prev = index > 0 ? all[index - 1] : null;
        Next = index >= 0 && index < all.Count - 1 ? all[index + 1] : null;

        _ready = true;

        if (Pizza is null && Http is { Response.HasStarted: false })
        {
            Http.Response.StatusCode = 404;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Pizza is null)
        {
            return;
        }

        if (_restoreLeaf)
        {
            try
            {
                var changed = await RestoreLeaf();
                _restoreLeaf = false;
                if (changed)
                {
                    return;
                }
            }
            catch (InvalidOperationException)
            {
                return;
            }
            catch (JSDisconnectedException)
            {
                return;
            }
            catch (JSException)
            {
                _restoreLeaf = false;
            }
        }

        if (!firstRender && _mounted && _mountedSlug == Slug)
        {
            try
            {
                if (_freshExtra is not null)
                {
                    var id = _freshExtra;
                    await JS.InvokeVoidAsync("FornoMotion.dropExtra", _root, id);
                    _freshExtra = null;
                }

                await JS.InvokeVoidAsync("FornoMotion.chromeDetail", _root);
            }
            catch (Exception)
            {
            }

            return;
        }

        var fresh = firstRender || _mountedSlug != Slug;
        _mountedSlug = Slug;

        try
        {
            await JS.InvokeVoidAsync("FornoMotion.mountDetail", _root, fresh);
            _mounted = true;
        }
        catch (Exception)
        {
        }
    }

    private async Task Less()
    {
        Quantity = Math.Max(1, Quantity - 1);
        await RememberLeaf();
    }

    private async Task More()
    {
        Quantity = Math.Min(12, Quantity + 1);
        await RememberLeaf();
    }

    private void Add()
    {
        if (Pizza is null)
        {
            return;
        }

        Cart.Add(Pizza, Quantity, ExtraIds);
        JustAdded = true;
    }

    private bool HasExtra(string id) =>
        ExtraIds.Contains(id, StringComparer.OrdinalIgnoreCase);

    private void OpenMise() => MiseOpen = true;

    private void CloseMise() => MiseOpen = false;

    private async Task ToggleExtra(string id)
    {
        if (HasExtra(id))
        {
            try
            {
                await JS.InvokeVoidAsync("FornoMotion.liftExtra", _root, id);
            }
            catch (Exception)
            {
            }

            ExtraIds.RemoveAll(x => x.Equals(id, StringComparison.OrdinalIgnoreCase));
            _freshExtra = null;
            await RememberLeaf();
            return;
        }

        if (ExtraIds.Count >= OvenExtras.MaxOnLeaf)
        {
            return;
        }

        ExtraIds.Add(id);
        _freshExtra = id;
        await RememberLeaf();
    }

    private async Task<bool> RestoreLeaf()
    {
        var saved = await JS.InvokeAsync<string[]>("FornoCart.leafGet", Slug);
        var qty = await JS.InvokeAsync<int>("FornoCart.leafQty", Slug);
        var ids = OvenExtras.Normalize(saved);
        if (ids.Count == 0)
        {
            var line = Cart.Lines.LastOrDefault(l =>
                l.Pizza.Slug.Equals(Slug, StringComparison.OrdinalIgnoreCase));
            ids = OvenExtras.Normalize(line?.ExtraIds);
            if (line is not null && qty == 1)
            {
                qty = line.Quantity;
            }
        }

        qty = Math.Clamp(qty, 1, 12);
        var same = ExtraIds.Count == ids.Count
            && OvenExtras.Same(ExtraIds, ids)
            && Quantity == qty;
        if (same)
        {
            return false;
        }

        ExtraIds.Clear();
        ExtraIds.AddRange(ids);
        Quantity = qty;
        StateHasChanged();
        return true;
    }

    private async Task RememberLeaf()
    {
        try
        {
            await JS.InvokeVoidAsync("FornoCart.leafSet", Slug, ExtraIds.ToArray(), Quantity);
        }
        catch (InvalidOperationException)
        {
        }
        catch (JSException)
        {
        }
    }

    private static IEnumerable<string> Stamps(PizzaItem pizza)
    {
        foreach (var tag in pizza.Tags.Split(' ', StringSplitOptions.RemoveEmptyEntries))
        {
            yield return tag switch
            {
                "klasika" => "Klasika",
                "pikant" => "Pikant",
                "bez-masa" => "Bez mäsa",
                "syry" => "Syry",
                _ => tag
            };
        }
    }

    private static int SharesTags(PizzaItem a, PizzaItem b)
    {
        var left = a.Tags.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var right = b.Tags.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return left.Count(t => right.Contains(t, StringComparer.OrdinalIgnoreCase));
    }

    public async ValueTask DisposeAsync()
    {
        if (!_mounted)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("FornoMotion.unmount");
        }
        catch (Exception)
        {
        }
    }
}
