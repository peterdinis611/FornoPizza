@page "/checkout"
@inject CartService Cart
@inject IOrderService Orders
@inject IPaymentService Payments
@inject NavigationManager Nav
@using Forno.Domain

<PageTitle>Objednávka — Forno</PageTitle>
<Seo Title="Objednávka — 800° Forno"
     Description="Objednávka a platba kartou z pece 800° Forno. Bez účtu."
     NoIndex="true" />

<section class="page-head">
    <p class="eyebrow">@(Payments.IsEnabled ? "Platba kartou" : "Objednávka")</p>
    <h1>Objednávka</h1>
</section>

@if (Submitted && Receipt is not null)
{
    <div class="ticket">
        <p class="eyebrow">Pec prijala lístok</p>
        <h2>Ďakujeme, @Receipt.Name.</h2>
        <p>Lístok č. @Receipt.Id · @Receipt.Total.ToString("N2") € je zapísaný v peci. Ozveme sa na telefón alebo e-mail.</p>
        <a class="btn" href="/menu">Späť k menu</a>
    </div>
}
else if (Cart.IsEmpty)
{
    <p class="empty">Najprv si vyberte pizzu. <a href="/menu">Menu</a></p>
}
else
{
    @if (Cancelled)
    {
        <p class="form-alert" role="status">Platba zrušená. Môžete skúsiť znova.</p>
    }

    @if (!Payments.IsEnabled)
    {
        <p class="form-alert" role="alert">
            Stripe nie je nakonfigurovaný — objednávka prebehne bez platby kartou.
        </p>
    }

    <form class="checkout" @onsubmit="Submit" @onsubmit:preventDefault>
        <p class="sum">@Cart.Count ks · @Cart.Total.ToString("N2") €</p>
        @if (!string.IsNullOrEmpty(FormError("cart")) || !string.IsNullOrEmpty(FormError("order")) || !string.IsNullOrEmpty(FormError("fulfillment")) || !string.IsNullOrEmpty(FormError("payment")))
        {
            <p class="form-alert" role="alert">@(FormError("cart") ?? FormError("fulfillment") ?? FormError("payment") ?? FormError("order"))</p>
        }

        <fieldset class="fulfill-toggle">
            <legend>Spôsob</legend>
            <div class="fulfill-row">
                <button type="button" class="@FulfillClass(FulfillmentMode.Pickup)" @onclick="() => SetFulfillment(FulfillmentMode.Pickup)">
                    Výdaj pri peci
                    <span>15–20 min</span>
                </button>
                <button type="button" class="@FulfillClass(FulfillmentMode.Delivery)" @onclick="() => SetFulfillment(FulfillmentMode.Delivery)">
                    Rozvoz
                    <span>od @OvenCommerce.ShipMinimum.ToString("N0") € · zadarmo @OvenCommerce.FreeShipMinimum.ToString("N0") €</span>
                </button>
            </div>
        </fieldset>

        <label>
            Meno a priezvisko
            <input @bind="Name"
                   @bind:event="oninput"
                   required
                   maxlength="@OvenLimits.NameMax"
                   autocomplete="name"
                   aria-invalid="@Invalid("name")" />
            @if (FormError("name") is { } nameErr)
            {
                <span class="field-error">@nameErr</span>
            }
        </label>
        <label>
            E-mail
            <input @bind="Email"
                   @bind:event="oninput"
                   type="email"
                   required
                   maxlength="@OvenLimits.EmailMax"
                   inputmode="email"
                   autocomplete="email"
                   placeholder="meno@email.sk"
                   aria-invalid="@Invalid("email")" />
            @if (FormError("email") is { } emailErr)
            {
                <span class="field-error">@emailErr</span>
            }
        </label>
        <label>
            Telefón
            <input @bind="Phone"
                   @bind:event="oninput"
                   type="tel"
                   required
                   maxlength="@OvenLimits.PhoneMax"
                   inputmode="tel"
                   autocomplete="tel"
                   placeholder="0905 123 456"
                   aria-invalid="@Invalid("phone")" />
            @if (FormError("phone") is { } phoneErr)
            {
                <span class="field-error">@phoneErr</span>
            }
        </label>
        @if (Fulfillment == FulfillmentMode.Delivery)
        {
            <label>
                Adresa doručenia
                <input @bind="Address"
                       @bind:event="oninput"
                       required
                       maxlength="@OvenLimits.AddressMax"
                       autocomplete="street-address"
                       placeholder="Hlavná 12, Bardejov"
                       aria-invalid="@Invalid("address")" />
                @if (FormError("address") is { } addressErr)
                {
                    <span class="field-error">@addressErr</span>
                }
            </label>
        }
        else
        {
            <p class="fulfill-note">Vyzdvihnete pri peci v Bardejove. Adresa netreba.</p>
        }

        <div class="note-chips">
            <span class="note-chips-label">Alergie / preferencie</span>
            <div class="chip-row">
                @foreach (var chip in OrderNoteChips.All)
                {
                    <button type="button" class="note-chip @(SelectedChips.Contains(chip) ? "is-on" : null)" @onclick="() => ToggleChip(chip)">
                        @chip
                    </button>
                }
            </div>
        </div>

        <label>
            Poznámka
            <textarea @bind="NoteExtra"
                      @bind:event="oninput"
                      rows="3"
                      maxlength="@OvenLimits.NoteMax"
                      placeholder="Ešte niečo pre pec…"
                      aria-invalid="@Invalid("note")"></textarea>
            @if (FormError("note") is { } noteErr)
            {
                <span class="field-error">@noteErr</span>
            }
        </label>
        <button class="btn tomato" type="submit" disabled="@_busy">
            @SubmitLabel
        </button>
        @if (Payments.IsEnabled)
        {
            <p class="fulfill-note">Platba cez Stripe. Karta, Apple Pay, Google Pay.</p>
        }
    </form>
}

@code {
    [SupplyParameterFromQuery]
    public bool Cancelled { get; set; }

    private string Name { get; set; } = "";
    private string Email { get; set; } = "";
    private string Phone { get; set; } = "";
    private string Address { get; set; } = "";
    private string NoteExtra { get; set; } = "";
    private FulfillmentMode Fulfillment { get; set; } = FulfillmentMode.Delivery;
    private HashSet<string> SelectedChips { get; } = new(StringComparer.Ordinal);
    private bool _busy;
    private bool Submitted { get; set; }
    private OrderReceipt? Receipt { get; set; }
    private IReadOnlyList<FieldError> Errors { get; set; } = [];

    private string SubmitLabel =>
        _busy
            ? (Payments.IsEnabled ? "Pripravujeme platbu…" : "Odosielame…")
            : (Payments.IsEnabled ? "Zaplatiť a objednať" : "Odoslať objednávku");

    private string? FormError(string field) =>
        Errors.FirstOrDefault(error => error.Field.Equals(field, StringComparison.OrdinalIgnoreCase))?.Message;

    private string Invalid(string field) =>
        FormError(field) is null ? "false" : "true";

    private string FulfillClass(FulfillmentMode mode) =>
        Fulfillment == mode ? "fulfill-opt is-on" : "fulfill-opt";

    private void SetFulfillment(FulfillmentMode mode)
    {
        Fulfillment = mode;
        Errors = Errors.Where(error =>
            !error.Field.Equals("address", StringComparison.OrdinalIgnoreCase)
            && !error.Field.Equals("fulfillment", StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private void ToggleChip(string chip)
    {
        if (!SelectedChips.Add(chip))
        {
            SelectedChips.Remove(chip);
        }
    }

    private async Task Submit()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        Errors = [];

        var note = OrderNoteChips.Merge(SelectedChips, NoteExtra);
        var address = Fulfillment == FulfillmentMode.Pickup
            ? OvenCommerce.PickupAddress
            : Address;

        var request = new PlaceOrderRequest(
            Name,
            Email,
            Phone,
            address,
            note,
            Cart.Lines,
            Fulfillment);

        var local = CheckoutValidator.Validate(request);
        if (local.Count > 0)
        {
            Errors = local;
            _busy = false;
            return;
        }

        var result = await Orders.PlaceAsync(request);

        if (!result.IsSuccess || result.Value is null)
        {
            Errors = result.Errors;
            _busy = false;
            return;
        }

        if (!Payments.IsEnabled)
        {
            Receipt = result.Value;
            Cart.Clear();
            Submitted = true;
            _busy = false;
            return;
        }

        var session = await Payments.CreateCheckoutSessionAsync(result.Value.Id, Nav.BaseUri);
        if (!session.IsSuccess || session.Value is null)
        {
            Errors = session.Errors;
            _busy = false;
            return;
        }

        Nav.NavigateTo(session.Value, forceLoad: true);
    }
}
