@page "/"
@inject IJSRuntime JS
@inject CartService Cart
@inject IMenuService Menu
@inject IShopService Shop
@inject ISubscriberService Subscribers
@inject NavigationManager Nav
@implements IAsyncDisposable

<PageTitle>800° Forno — neapolská pizza, Bardejov</PageTitle>
<Seo Title="800° Forno — neapolská pizza, Bardejov"
     Description="Pizza z múky, dymu a času. Neapolská pec v Bardejove, 800°, 90 sekúnd, 48 hodín kvasenia. Objednajte z webu — zatiaľ bez účtu."
     Path="/"
     JsonLd="@JsonLd" />

<div class="hearth" @ref="_root">
    <section class="hero-stage">
        <div class="hero-copy">
            <p class="hero-kicker" data-reveal>
                <span class="live-dot" aria-hidden="true"></span>
                Pec horí · Bardejov · dnes do 22:00
            </p>
            <h1 class="hero-title" aria-label="Forno">
                <span class="hero-title-line">
                    @foreach (var letter in "FORNO")
                    {
                        <span class="char" aria-hidden="true">@letter</span>
                    }
                </span>
            </h1>
            <p class="lede" data-reveal>
                Pizza z múky, dymu a času. Objednajte si ju ešte kým je kôra chrumkavá.
            </p>
            <div class="hero-actions" data-reveal>
                <a class="btn tomato" data-magnetic href="/menu">Otvoriť menu</a>
                <a class="btn" data-magnetic href="#ako">Ako objednať</a>
            </div>
            <dl class="hearth-stats" data-reveal>
                <div>
                    <dt data-count="800" data-suffix="°">800°</dt>
                    <dd>teplota peci</dd>
                </div>
                <div>
                    <dt data-count="90" data-suffix="s">90s</dt>
                    <dd>v ohni</dd>
                </div>
                <div>
                    <dt data-count="48" data-suffix="h">48h</dt>
                    <dd>kvasenie</dd>
                </div>
            </dl>
        </div>

        <div class="oven-mouth" data-tilt>
            <span class="ember" style="--x: 18%; --delay: 0s"></span>
            <span class="ember" style="--x: 42%; --delay: 1.1s"></span>
            <span class="ember" style="--x: 61%; --delay: 0.4s"></span>
            <span class="ember" style="--x: 77%; --delay: 1.8s"></span>
            <span class="ember" style="--x: 33%; --delay: 2.4s"></span>
            <div class="oven-soot"></div>
            <svg class="heat-ring" viewBox="0 0 200 200" aria-hidden="true">
                <defs>
                    <path id="heat-path" d="M100,100 m-90,0 a90,90 0 1,1 180,0 a90,90 0 1,1 -180,0" fill="none" />
                </defs>
                <text>
                    <textPath href="#heat-path">800° · FORNO · NEAPOLSKÁ PEC · 800° · FORNO · NEAPOLSKÁ PEC · </textPath>
                </text>
            </svg>
            <div class="oven-pie">
                <PizzaMark Slug="margherita" MarkId="hero" />
            </div>
            <div class="kiln-door kiln-door-a" aria-hidden="true"></div>
            <div class="kiln-door kiln-door-b" aria-hidden="true"></div>
            <span class="oven-seal">90 sekúnd</span>
        </div>

        <a class="scroll-cue" href="#dnes" data-reveal>
            <span>List dňa</span>
            <b></b>
        </a>
    </section>

    <div class="ticker" aria-hidden="true">
        <div class="ticker-track">
            @for (var i = 0; i < 2; i++)
            {
                <span>800° · San Marzano · drevo buka · 48 hodín kvasenia · fior di latte · Bardejov · 90 sekúnd · neapolská pec · olivový olej · </span>
            }
        </div>
    </div>

    <aside class="service-rail" data-scroll>
        <p><strong>11–22</strong> dnes otvorené</p>
        <p><strong>15–20 min</strong> výdaj z peci</p>
        <p><strong>od 12 €</strong> rozvoz · zadarmo od 22 €</p>
        <p><strong>Bez účtu</strong> objednávka z webu</p>
    </aside>

    <section class="shop-find" data-scroll>
        <OvenSearch Items="MenuItems" Variant="home" />
        <nav class="tag-row" aria-label="Kategórie">
            <a href="/menu?tag=klasika">Klasika</a>
            <a href="/menu?tag=pikant">Pikantné</a>
            <a href="/menu?tag=bez-masa">Bez mäsa</a>
            <a href="/menu?tag=syry">Syry</a>
        </nav>
    </section>

    <section class="featured-spread" id="dnes">
        <header class="spread-head" data-scroll>
            <p class="eyebrow">List dňa</p>
            <h2>Dnes v peci</h2>
            <a href="/menu">Celé menu →</a>
        </header>
        <ol class="fire-board">
            @foreach (var (pizza, i) in TodaySpread.Select((p, i) => (p, i)))
            {
                var isLead = i == 0 && DaySpecial is not null && pizza.Slug == DaySpecial.Slug;
                <li class="fire-card @(isLead ? "fire-card-lead" : "fire-card-side")" data-scroll data-tilt>
                    <a href="/menu/@pizza.Slug">
                        <span class="fire-num">@((i + 1).ToString("00"))</span>
                        @if (isLead)
                        {
                            <span class="fire-stamp">List dňa</span>
                        }
                        <PizzaMark Slug="@pizza.Slug" MarkId="@($"feat-{pizza.Slug}")" />
                        <span class="row-copy">
                            <strong>@pizza.Name</strong>
                            <em>@pizza.Tagline</em>
                            @if (isLead)
                            {
                                <span class="ingredients">@pizza.Ingredients</span>
                            }
                        </span>
                        <span class="price">@pizza.Price.ToString("N2") €</span>
                    </a>
                    <button class="btn tomato fire-add" type="button" @onclick="() => Add(pizza)">
                        @(InCart(pizza) ? "Pridať ďalšiu" : "Do košíka")
                    </button>
                </li>
            }
        </ol>
    </section>

    <section class="order-path" id="ako">
        <header class="spread-head" data-scroll>
            <p class="eyebrow">E-shop</p>
            <h2>Ako objednať</h2>
        </header>
        <ol class="path-steps">
            <li data-scroll>
                <span>01</span>
                <strong>Vyberte list</strong>
                <em>Šesť píz v peci. Hľadajte, filtrujte, dajte do košíka.</em>
            </li>
            <li data-scroll>
                <span>02</span>
                <strong>Pec spečie</strong>
                <em>Deväťdesiat sekúnd pri 800°. Kôra ide von ešte horúca.</em>
            </li>
            <li data-scroll>
                <span>03</span>
                <strong>Donesieme</strong>
                <em>Výdaj 15–20 min. Rozvoz po Bardejove 30–40 min.</em>
            </li>
        </ol>
    </section>

    <section class="delivery-sheet" id="rozvoz" data-scroll>
        <div>
            <p class="eyebrow">Rozvoz</p>
            <h2>Bardejov a okolie</h2>
            <p class="oven-lede">Minimum 12 €. Nad 22 € ide rozvoz zadarmo. Platba kartou pri objednávke cez Stripe.</p>
        </div>
        <ul>
            <li><strong>Centrum</strong><span>15–25 min</span></li>
            <li><strong>Okolie mesta</strong><span>30–40 min</span></li>
            <li><strong>Výdaj pri peci</strong><span>15–20 min</span></li>
            <li><strong>Alergény</strong><span>cesto z pšenice · v poznámke napíšte viac</span></li>
        </ul>
    </section>

    <section class="voices" data-scroll>
        <div class="voices-score">
            <strong>4,9</strong>
            <em>128 objednávok z peci</em>
        </div>
        <blockquote>
            <p>Kôra praskala ešte v krabici. Takto má chutiť Bardejov v noci.</p>
            <cite>Marta · centrum</cite>
        </blockquote>
        <blockquote>
            <p>Diavola nie je agresívna. Med a chili sedia. Pec vie, kedy prestať.</p>
            <cite>Ondrej · okolie</cite>
        </blockquote>
        <blockquote>
            <p>Bez účtu, bez čakania na aplikáciu. Objednal som a za dvadsať minút bola kôra tu.</p>
            <cite>Lea · výdaj</cite>
        </blockquote>
    </section>

    <section class="faq" id="faq">
        <header class="spread-head" data-scroll>
            <p class="eyebrow">Otázky</p>
            <h2>Pred pecou</h2>
        </header>
        <div data-scroll>
            <details>
                <summary>Ako dlho trvá objednávka?</summary>
                <p>Výdaj 15–20 minút. Rozvoz po Bardejove 30–40 minút, podľa toho, kde pec práve horí.</p>
            </details>
            <details>
                <summary>Je potrebný účet?</summary>
                <p>Nie. Meno, telefón a adresa stačia. Zatiaľ neberieme platbu ani prihlasovanie.</p>
            </details>
            <details>
                <summary>Čo s alergiami?</summary>
                <p>Cesto je z pšeničnej múky. Marinara je bez syra. V poznámke k objednávke napíšte, čo pec nesmie.</p>
            </details>
            <details>
                <summary>Od koľkých eur vozíte?</summary>
                <p>Od 12 €. Nad 22 € je rozvoz zadarmo. Menšie objednávky sú na výdaj pri peci.</p>
            </details>
        </div>
    </section>

    <section class="letter" data-scroll>
        <p class="eyebrow">List z peci</p>
        <h2>Nové listy, nie spam</h2>
        @if (Subscribed)
        {
            <p class="oven-lede">Máme vás. Keď pôjde do peci niečo nové, ozveme sa.</p>
        }
        else
        {
            <form class="letter-form" @onsubmit="Subscribe" @onsubmit:preventDefault>
                <label>
                    E-mail
                    <input type="email" @bind="Email" required maxlength="120" placeholder="vas@email.sk" aria-invalid="@(SubscribeError is null ? "false" : "true")" />
                    @if (!string.IsNullOrEmpty(SubscribeError))
                    {
                        <span class="field-error">@SubscribeError</span>
                    }
                </label>
                <button class="btn tomato" type="submit">Zapísať</button>
            </form>
        }
    </section>

    <section class="oven-band" id="pec">
        <span class="oven-watermark" aria-hidden="true">800°</span>
        <p class="eyebrow" data-scroll>Pec</p>
        <h2 data-scroll>Hovorí až pri osemsto stupňoch</h2>
        <p class="oven-lede" data-scroll>
            Žiadny plyn, žiadny spech. Bukové drevo, cesto z dvoch dní a kôra, ktorá praská ešte na stole.
        </p>
        <ul class="pillars">
            <li data-scroll>
                <span>01</span>
                <strong>Drevo</strong>
                <em>Buk z okolia. Oheň, ktorý vonia a neponáhľa sa.</em>
            </li>
            <li data-scroll>
                <span>02</span>
                <strong>Cesto</strong>
                <em>Múka, voda, soľ. Štyridsaťosem hodín, kým ide do pece.</em>
            </li>
            <li data-scroll>
                <span>03</span>
                <strong>Oheň</strong>
                <em>Osemsto stupňov. Deväťdesiat sekúnd. Potom už len kôra.</em>
            </li>
        </ul>
        <a class="btn tomato oven-cta" data-magnetic data-scroll href="/menu">Objednať z peci</a>
    </section>
</div>

@code {
    private ElementReference _root;
    private bool _mounted;
    private IReadOnlyList<PizzaItem> TodaySpread { get; set; } = [];
    private PizzaItem? DaySpecial { get; set; }
    private IReadOnlyList<PizzaItem> MenuItems { get; set; } = [];
    private string Email { get; set; } = "";
    private bool Subscribed { get; set; }
    private string? SubscribeError { get; set; }

    private string JsonLd
    {
        get
        {
            var url = Nav.BaseUri.TrimEnd('/');
            return $$"""
            {"@context":"https://schema.org","@type":"Pizzeria","name":"800° Forno","url":"{{url}}","description":"Neapolská pizza z pece v Bardejove. 800°, 90 sekúnd, 48 hodín kvasenia.","address":{"@type":"PostalAddress","addressLocality":"Bardejov","addressCountry":"SK"},"openingHoursSpecification":{"@type":"OpeningHoursSpecification","dayOfWeek":["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],"opens":"11:00","closes":"22:00"},"servesCuisine":["Pizza","Neapolitan"],"priceRange":"€€","hasMenu":"{{url}}/menu"}
            """;
        }
    }

    private bool InCart(PizzaItem pizza) =>
        Cart.Lines.Any(line => line.Pizza.Slug == pizza.Slug);

    private void Add(PizzaItem pizza) => Cart.Add(pizza);

    private async Task Subscribe()
    {
        SubscribeError = null;
        var result = await Subscribers.AddAsync(Email);
        if (result.IsSuccess)
        {
            Subscribed = true;
            return;
        }

        SubscribeError = result["email"] ?? result.Errors.FirstOrDefault()?.Message;
    }

    protected override async Task OnInitializedAsync()
    {
        DaySpecial = await Shop.DaySpecialAsync();
        var featured = await Menu.FeaturedAsync();
        var spread = new List<PizzaItem>();
        if (DaySpecial is not null)
        {
            spread.Add(DaySpecial);
        }

        spread.AddRange(featured.Where(pizza =>
            DaySpecial is null || !pizza.Slug.Equals(DaySpecial.Slug, StringComparison.OrdinalIgnoreCase)));
        TodaySpread = spread;
        MenuItems = await Menu.AllAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("FornoMotion.mount", _root);
            _mounted = true;
        }
        catch (JSException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (!_mounted)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("FornoMotion.unmount");
        }
        catch (JSException)
        {
        }
    }
}
