@page "/cart"
@inject CartService Cart
@inject IJSRuntime JS
@using Forno.Domain
@implements IDisposable
@implements IAsyncDisposable

<PageTitle>Košík — Forno</PageTitle>
<Seo Title="Košík — 800° Forno"
     Description="Váš košík z pece 800° Forno. Objednávka a platba kartou cez Stripe."
     NoIndex="true" />

<article class="slip" @ref="_root">
    <span class="slip-watermark" aria-hidden="true">800°</span>

    <header class="slip-mast">
        <p class="eyebrow slip-kicker">Ešte pred pecou</p>
        <h1 aria-label="Košík">
            <span class="hero-title-line">
                @foreach (var letter in "KOŠÍK")
                {
                    <span class="char" aria-hidden="true">@letter</span>
                }
            </span>
        </h1>
        @if (!Cart.IsEmpty)
        {
            <p class="slip-stamp">@Cart.Count @(Cart.Count == 1 ? "list" : "ks")</p>
        }
    </header>

    @if (Cart.IsEmpty)
    {
        <div class="slip-void">
            <div class="slip-void-kiln" aria-hidden="true">
                <span class="slip-void-ring"></span>
                <span class="slip-void-hole"></span>
            </div>
            <div class="slip-void-copy">
                <p class="slip-void-lede">Pec čaká na list. Kôra ešte nie je na lístku.</p>
                <a class="btn tomato" href="/menu" data-magnetic>Otvoriť menu</a>
            </div>
        </div>
    }
    else
    {
        <div class="slip-sheet">
            <div class="slip-board">
                <div class="slip-cols" aria-hidden="true">
                    <span>List</span>
                    <span>Kusy</span>
                    <span>Suma</span>
                </div>
                <ol class="slip-lines">
                    @foreach (var entry in Cart.Lines.Select((line, index) => (line, index)))
                    {
                        var line = entry.line;
                        var i = entry.index;
                        var lineKey = line.Key;
                        var lineQty = line.Quantity;
                        var mark = $"cart-{i}-{line.Pizza.Slug}";
                        <li class="slip-line" @key="lineKey" style="--tilt: @((i % 2 == 0 ? -0.7 : 0.55).ToString(System.Globalization.CultureInfo.InvariantCulture))deg">
                            <span class="slip-no">@((i + 1).ToString("00"))</span>
                            <div class="slip-pie-stage">
                                <span class="slip-pie-ring" aria-hidden="true"></span>
                                <a class="slip-pie" href="/menu/@line.Pizza.Slug" aria-hidden="true" tabindex="-1">
                                    <PizzaMark Slug="@line.Pizza.Slug" MarkId="@mark" Extras="@line.ExtraIds" />
                                </a>
                            </div>
                            <div class="slip-copy">
                                <a href="/menu/@line.Pizza.Slug"><strong>@line.Pizza.Name</strong></a>
                                <em>@line.Pizza.Tagline</em>
                                <p>@line.UnitTotal.ToString("N2") € / ks</p>
                                @if (line.ExtraIds.Count > 0)
                                {
                                    <ul class="slip-chips">
                                        @foreach (var extra in line.ExtraIds)
                                        {
                                            var item = OvenExtras.Find(extra);
                                            if (item is not null)
                                            {
                                                <li>@item.Name</li>
                                            }
                                        }
                                    </ul>
                                }
                            </div>
                            <div class="slip-act">
                                <div class="qty-step slip-qty" aria-label="Kusy">
                                    <button type="button" @onclick="@(() => Less(lineKey, lineQty))" @onclick:stopPropagation="true" aria-label="@(lineQty == 1 ? "Odstrániť z košíka" : "Menej")">−</button>
                                    <span aria-live="polite">@lineQty</span>
                                    <button type="button" @onclick="@(() => More(lineKey, lineQty))" @onclick:stopPropagation="true" aria-label="Viac">+</button>
                                </div>
                                <span class="slip-sum">@line.LineTotal.ToString("N2") €</span>
                                <button type="button" class="slip-off" @onclick="@(() => Remove(lineKey))" @onclick:stopPropagation="true">Odstrániť</button>
                            </div>
                        </li>
                    }
                </ol>
            </div>

            <aside class="slip-stub" data-tilt>
                <span class="slip-stub-tear" aria-hidden="true"></span>
                <p class="slip-stub-kicker">Uhlíková kópia · Bardejov</p>
                <p class="slip-stub-label">Spolu</p>
                <strong class="slip-total">@Cart.Total.ToString("N2") €</strong>
                <dl class="slip-meta">
                    <div>
                        <dt>Kusy</dt>
                        <dd>@Cart.Count</dd>
                    </div>
                    <div>
                        <dt>Listy</dt>
                        <dd>@Cart.Lines.Count</dd>
                    </div>
                </dl>
                <div class="slip-heat-wrap">
                    <div class="slip-heat" style="--heat: @Heat.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                        <i></i>
                        <span class="slip-heat-mark" style="--at: @ShipMark.ToString(System.Globalization.CultureInfo.InvariantCulture)">@OvenCommerce.ShipMinimum.ToString("N0") €</span>
                        <span class="slip-heat-mark is-free" style="--at: 1">@OvenCommerce.FreeShipMinimum.ToString("N0") €</span>
                    </div>
                    <p class="slip-heat-note">@HeatNote</p>
                </div>
                <a class="btn tomato slip-go" href="/checkout" data-magnetic>K objednávke</a>
                <a class="slip-more" href="/menu">Ešte list</a>
                <p class="slip-pay">Platba kartou cez Stripe</p>
            </aside>
        </div>

        <blockquote class="slip-quote">
            <p>Košík nie je sklad. Je to lístok, ktorý ešte nešiel do ohňa.</p>
            <footer>Zápis z pece · pred objednávkou</footer>
        </blockquote>
    }
</article>

@code {
    private ElementReference _root;
    private bool _mounted;
    private bool _empty = true;

    private decimal Heat => Math.Clamp(Cart.Total / OvenCommerce.FreeShipMinimum, 0, 1);

    private decimal ShipMark => OvenCommerce.ShipMinimum / OvenCommerce.FreeShipMinimum;

    private string HeatNote
    {
        get
        {
            if (Cart.Total >= OvenCommerce.FreeShipMinimum)
            {
                return "Rozvoz zadarmo. Pec to unesie.";
            }

            if (Cart.Total >= OvenCommerce.ShipMinimum)
            {
                return $"Rozvoz. Ešte {(OvenCommerce.FreeShipMinimum - Cart.Total).ToString("N2")} € do voľného.";
            }

            return $"Ešte {(OvenCommerce.ShipMinimum - Cart.Total).ToString("N2")} € do rozvozu. Alebo výdaj pri peci.";
        }
    }

    protected override void OnInitialized() => Cart.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var empty = Cart.IsEmpty;
        if (!firstRender && _mounted && empty == _empty)
        {
            return;
        }

        _empty = empty;
        try
        {
            await JS.InvokeVoidAsync("FornoMotion.mountCart", _root, firstRender);
            _mounted = true;
        }
        catch (Exception)
        {
        }
    }

    private void Less(string key, int quantity)
    {
        if (quantity <= 1)
        {
            Cart.Remove(key);
            return;
        }

        Cart.SetQuantity(key, quantity - 1);
    }

    private void More(string key, int quantity) => Cart.SetQuantity(key, quantity + 1);

    private void Remove(string key) => Cart.Remove(key);

    public void Dispose() => Cart.Changed -= OnChanged;

    public async ValueTask DisposeAsync()
    {
        Dispose();
        if (!_mounted)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("FornoMotion.unmount");
        }
        catch (Exception)
        {
        }
    }
}
