@page "/kosik"
@inject CartService Cart
@inject IJSRuntime JS
@implements IDisposable
@implements IAsyncDisposable

<PageTitle>Košík — Forno</PageTitle>
<Seo Title="Košík — 800° Forno"
     Description="Váš košík z pece 800° Forno. Objednávka z webu, zatiaľ bez platby."
     NoIndex="true" />

<article class="slip" @ref="_root">
    <header class="slip-mast">
        <p class="eyebrow slip-copy">Ešte pred pecou</p>
        <h1 class="slip-title" aria-label="Košík">
            <span class="hero-title-line">
                @foreach (var letter in "KOŠÍK")
                {
                    <span class="char" aria-hidden="true">@letter</span>
                }
            </span>
        </h1>
        <p class="slip-lede slip-copy">
            @(Cart.IsEmpty
                ? "Pec čaká na list. Zatiaľ bez platby a bez účtu."
                : $"{Cart.Count} {(Cart.Count == 1 ? "list" : "listov")} na lístku. Zatiaľ bez platby.")
        </p>
        <span class="slip-seal" aria-hidden="true">@(Cart.IsEmpty ? "—" : Cart.Count.ToString("00"))</span>
    </header>

    @if (Cart.IsEmpty)
    {
        <div class="slip-void">
            <div class="slip-skillet" aria-hidden="true">
                <span class="slip-skillet-ring"></span>
                <span class="slip-skillet-core"></span>
                <b>800°</b>
            </div>
            <div class="slip-void-copy">
                <p class="slip-void-kicker">Žiadny list</p>
                <p>Ani kôrka. Ani dym. Otvorte menu a pec začne počítať.</p>
                <a class="btn tomato" href="/menu" data-magnetic>K listom</a>
            </div>
        </div>
    }
    else
    {
        <div class="slip-sheet">
            <ol class="slip-lines">
                @foreach (var (line, i) in Cart.Lines.Select((l, n) => (l, n)))
                {
                    <li class="slip-line">
                        <span class="slip-no">@((i + 1).ToString("00"))</span>
                        <a class="slip-pie" href="/menu/@line.Pizza.Slug" data-tilt aria-hidden="true" tabindex="-1">
                            <PizzaMark Slug="@line.Pizza.Slug" MarkId="@($"slip-{i}")" Extras="line.ExtraIds" />
                        </a>
                        <div class="slip-meta">
                            <a class="slip-name" href="/menu/@line.Pizza.Slug">@line.Pizza.Name</a>
                            <p>@line.UnitTotal.ToString("N2") € · kus</p>
                            @if (line.ExtraIds.Count > 0)
                            {
                                <ul class="slip-stamps">
                                    @foreach (var extra in line.ExtraIds)
                                    {
                                        <li>@OvenExtras.Find(extra)?.Name</li>
                                    }
                                </ul>
                            }
                            <a class="slip-edit" href="/menu/@line.Pizza.Slug">Upraviť list</a>
                        </div>
                        <div class="qty-step slip-qty" aria-label="Kusy">
                            <button type="button" @onclick="() => Less(line.Key, line.Quantity)" aria-label="Menej" disabled="@(line.Quantity <= 1)">−</button>
                            <span>@line.Quantity</span>
                            <button type="button" @onclick="() => More(line.Key, line.Quantity)" aria-label="Viac" disabled="@(line.Quantity >= 12)">+</button>
                        </div>
                        <strong class="slip-sum">@line.LineTotal.ToString("N2") €</strong>
                        <button type="button" class="slip-drop" @onclick="() => Cart.Remove(line.Key)" aria-label="@($"Odstrániť {line.Pizza.Name}")">×</button>
                    </li>
                }
            </ol>

            <aside class="slip-stub">
                <p class="slip-stub-mark">Duplikát</p>
                <p class="slip-stub-id">Bardejov · 800°</p>
                <p class="slip-stub-count">@Cart.Count ks</p>
                <p class="slip-stub-total">@Cart.Total.ToString("N2") <span>€</span></p>
                <div class="slip-heat" style="--heat: @HeatPct" aria-hidden="true">
                    <i></i>
                    <span class="slip-heat-dot" style="left: 54.5%"></span>
                    <span class="slip-heat-dot is-end"></span>
                </div>
                <p class="slip-heat-note">@HeatNote</p>
                <a class="btn tomato" href="/objednavka" data-magnetic>K objednávke</a>
                <a class="slip-back" href="/menu">Ešte na list</a>
                <p class="slip-pay">Zatiaľ bez platby kartou. Pec prijme lístok a ozve sa.</p>
            </aside>
        </div>
    }
</article>

@code {
    private const decimal MinOrder = 12m;
    private const decimal FreeDelivery = 22m;

    private ElementReference _root;
    private bool _mounted;

    private int HeatPct =>
        (int)Math.Round(Math.Clamp((double)(Cart.Total / FreeDelivery) * 100d, 0, 100));

    private string HeatNote
    {
        get
        {
            if (Cart.Total >= FreeDelivery)
            {
                return "Rozvoz zadarmo. Pec vás vie.";
            }

            if (Cart.Total >= MinOrder)
            {
                var left = FreeDelivery - Cart.Total;
                return $"Rozvoz ide. Do zadarmo ešte {left.ToString("N2")} €.";
            }

            var need = MinOrder - Cart.Total;
            return $"Do minima ešte {need.ToString("N2")} €. Potom vie ísť rozvoz.";
        }
    }

    protected override void OnInitialized() => Cart.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender && _mounted)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("FornoMotion.mountCart", _root);
            _mounted = true;
        }
        catch (InvalidOperationException)
        {
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
            _mounted = true;
        }
    }

    private void Less(string key, int quantity)
    {
        if (quantity <= 1)
        {
            return;
        }

        Cart.SetQuantity(key, quantity - 1);
    }

    private void More(string key, int quantity)
    {
        if (quantity >= 12)
        {
            return;
        }

        Cart.SetQuantity(key, quantity + 1);
    }

    public void Dispose() => Cart.Changed -= OnChanged;

    public async ValueTask DisposeAsync()
    {
        Cart.Changed -= OnChanged;
        if (!_mounted)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("FornoMotion.unmount");
        }
        catch (Exception)
        {
        }
    }
}
