@page "/kosik"
@inject CartService Cart
@inject IJSRuntime JS
@implements IDisposable
@implements IAsyncDisposable

<PageTitle>Košík — Forno</PageTitle>
<Seo Title="Košík — 800° Forno"
     Description="Váš košík z pece 800° Forno. Objednávka z webu, zatiaľ bez platby."
     NoIndex="true" />

<article class="slip" @ref="_root">
    <header class="slip-mast">
        <p class="eyebrow slip-kicker">Ešte pred pecou</p>
        <h1 aria-label="Košík">
            <span class="hero-title-line">
                @foreach (var letter in "KOŠÍK")
                {
                    <span class="char" aria-hidden="true">@letter</span>
                }
            </span>
        </h1>
        @if (!Cart.IsEmpty)
        {
            <p class="slip-stamp">@Cart.Count @(Cart.Count == 1 ? "list" : "ks")</p>
        }
    </header>

    @if (Cart.IsEmpty)
    {
        <div class="slip-void">
            <div class="slip-void-kiln" aria-hidden="true">
                <span class="slip-void-ring"></span>
                <span class="slip-void-hole"></span>
            </div>
            <div class="slip-void-copy">
                <p class="slip-void-lede">Pec čaká na list. Kôra ešte nie je na lístku.</p>
                <a class="btn tomato" href="/menu" data-magnetic>Otvoriť menu</a>
            </div>
        </div>
    }
    else
    {
        <div class="slip-sheet">
            <ol class="slip-lines">
                @for (var i = 0; i < Cart.Lines.Count; i++)
                {
                    var line = Cart.Lines[i];
                    var mark = $"cart-{i}-{line.Pizza.Slug}";
                    <li class="slip-line">
                        <span class="slip-no">@((i + 1).ToString("00"))</span>
                        <a class="slip-pie" href="/menu/@line.Pizza.Slug" aria-hidden="true" tabindex="-1">
                            <PizzaMark Slug="@line.Pizza.Slug" MarkId="@mark" Extras="@line.ExtraIds" />
                        </a>
                        <div class="slip-copy">
                            <a href="/menu/@line.Pizza.Slug"><strong>@line.Pizza.Name</strong></a>
                            <p>@line.UnitTotal.ToString("N2") € / ks</p>
                            @if (line.ExtraIds.Count > 0)
                            {
                                <ul class="slip-chips">
                                    @foreach (var extra in line.ExtraIds)
                                    {
                                        var item = OvenExtras.Find(extra);
                                        if (item is not null)
                                        {
                                            <li>@item.Name</li>
                                        }
                                    }
                                </ul>
                            }
                        </div>
                        <div class="qty-step slip-qty" aria-label="Kusy">
                            <button type="button" @onclick="() => Less(line.Key, line.Quantity)" aria-label="Menej">−</button>
                            <span>@line.Quantity</span>
                            <button type="button" @onclick="() => More(line.Key, line.Quantity)" aria-label="Viac">+</button>
                        </div>
                        <span class="slip-sum">@line.LineTotal.ToString("N2") €</span>
                        <button type="button" class="slip-off" @onclick="() => Cart.Remove(line.Key)">Z listu</button>
                    </li>
                }
            </ol>

            <aside class="slip-stub" data-tilt>
                <p class="slip-stub-kicker">Uhlíková kópia · Bardejov</p>
                <p class="slip-stub-label">Spolu</p>
                <strong class="slip-total">@Cart.Total.ToString("N2") €</strong>
                <dl>
                    <div>
                        <dt>Kusy</dt>
                        <dd>@Cart.Count</dd>
                    </div>
                    <div>
                        <dt>Listy</dt>
                        <dd>@Cart.Lines.Count</dd>
                    </div>
                </dl>
                <div class="slip-heat" style="--heat: @Heat.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                    <i></i>
                </div>
                <p class="slip-heat-note">@HeatNote</p>
                <a class="btn tomato" href="/objednavka" data-magnetic>K objednávke</a>
                <a class="slip-more" href="/menu">Ešte list</a>
                <p class="slip-pay">Zatiaľ bez platby a účtu</p>
            </aside>
        </div>
    }
</article>

@code {
    private const decimal ShipFrom = 12m;
    private const decimal FreeFrom = 22m;

    private ElementReference _root;
    private bool _mounted;
    private bool _empty = true;

    private decimal Heat => Math.Clamp(Cart.Total / FreeFrom, 0, 1);

    private string HeatNote
    {
        get
        {
            if (Cart.Total >= FreeFrom)
            {
                return "Rozvoz zadarmo. Pec to unesie.";
            }

            if (Cart.Total >= ShipFrom)
            {
                return $"Rozvoz. Ešte {(FreeFrom - Cart.Total).ToString("N2")} € do voľného.";
            }

            return $"Ešte {(ShipFrom - Cart.Total).ToString("N2")} € do rozvozu. Alebo výdaj pri peci.";
        }
    }

    protected override void OnInitialized() => Cart.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var empty = Cart.IsEmpty;
        if (!firstRender && _mounted && empty == _empty)
        {
            return;
        }

        _empty = empty;
        try
        {
            await JS.InvokeVoidAsync("FornoMotion.mountCart", _root, firstRender);
            _mounted = true;
        }
        catch (Exception)
        {
        }
    }

    private void Less(string key, int quantity)
    {
        if (quantity > 1)
        {
            Cart.SetQuantity(key, quantity - 1);
        }
    }

    private void More(string key, int quantity)
    {
        Cart.SetQuantity(key, quantity + 1);
    }

    public void Dispose() => Cart.Changed -= OnChanged;

    public async ValueTask DisposeAsync()
    {
        Dispose();
        if (!_mounted)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("FornoMotion.unmount");
        }
        catch (Exception)
        {
        }
    }
}
