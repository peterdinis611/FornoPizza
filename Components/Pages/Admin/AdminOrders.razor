@page "/admin/orders"
@layout AdminLayout
@inject IAdminOrderService Orders
@inject NavigationManager Nav
@using Forno.Domain

<PageTitle>Objednávky — Admin</PageTitle>
<Seo Title="Objednávky — Admin" Description="Objednávky pece." NoIndex="true" />

<section class="admin-head">
    <p class="eyebrow">Kuchyňa</p>
    <h1>Objednávky</h1>
    <p class="lede">TanStack Table — sort, hľadanie, stránkovanie.</p>
</section>

<nav class="admin-filters" aria-label="Filter stavov">
    <button type="button" class="@FilterClass(null)" @onclick="() => SetFilter(null)">Všetko</button>
    @foreach (var status in FilterStatuses)
    {
        <button type="button" class="@FilterClass(status)" @onclick="() => SetFilter(status)">
            @OrderStatus.Label(status)
        </button>
    }
</nav>

@if (_loading)
{
    <p class="admin-muted">Načítavam lístky…</p>
}
else if (_items.Count == 0)
{
    <p class="admin-muted">Žiadne objednávky.</p>
}
else
{
    <AdminOrdersTable @key="_tableKey" Orders="_items" PageSize="10" />
}

@code {
    [SupplyParameterFromQuery]
    public string? Status { get; set; }

    private static readonly string[] FilterStatuses =
    [
        OrderStatus.PendingPayment,
        OrderStatus.Paid,
        OrderStatus.Accepted,
        OrderStatus.Baking,
        OrderStatus.Ready,
        OrderStatus.Done,
        OrderStatus.Cancelled
    ];

    private IReadOnlyList<AdminOrder> _items = [];
    private bool _loading = true;
    private string? _filter;
    private string _tableKey = "all";

    protected override async Task OnParametersSetAsync()
    {
        _filter = string.IsNullOrWhiteSpace(Status) ? null : Status.Trim().ToLowerInvariant();
        _tableKey = _filter ?? "all";
        _loading = true;
        var page = await Orders.ListAsync(_filter);
        _items = page.Items;
        _loading = false;
    }

    private string FilterClass(string? status) =>
        string.Equals(_filter, status, StringComparison.OrdinalIgnoreCase)
        || (_filter is null && status is null)
            ? "is-on"
            : "";

    private void SetFilter(string? status)
    {
        var url = string.IsNullOrWhiteSpace(status)
            ? "/admin/orders"
            : $"/admin/orders?status={Uri.EscapeDataString(status)}";
        Nav.NavigateTo(url);
    }
}
