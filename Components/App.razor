<!DOCTYPE html>
<html lang="sk">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f3ead8" />
    <meta name="color-scheme" content="light dark" />
    <meta name="author" content="800° Forno" />
    <base href="/" />
    <script>
        (function () {
            var stored = localStorage.getItem('forno-theme');
            var theme = stored === 'dark' || stored === 'light'
                ? stored
                : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            document.documentElement.setAttribute('data-theme', theme);
            document.documentElement.style.colorScheme = theme;
        })();
    </script>
    <ResourcePreloader />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@400;600;700;800&family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,600;1,7..72,400&family=Red+Hat+Text:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Forno.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="PageRenderMode" />
    <script>
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            document.documentElement.classList.add('has-motion');
            window.setTimeout(function () {
                if (!document.documentElement.classList.contains('motion-ready')) {
                    document.documentElement.classList.remove('has-motion');
                }
            }, 2500);
        }
    </script>
</head>

<body>
    <div class="ember-cursor" aria-hidden="true">
        <span class="ember-cursor-ring"></span>
        <span class="ember-cursor-core"></span>
    </div>
    <Routes @rendermode="PageRenderMode" />
    <ReconnectModal />
    <script src="@Assets["lib/anime.umd.min.js"]"></script>
    <script src="@Assets["js/theme.js"]"></script>
    <script src="@Assets["js/forno-motion.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext? Http { get; set; }

    private IComponentRenderMode? PageRenderMode
    {
        get
        {
            var path = Http?.Request.Path ?? PathString.Empty;
            if (path.StartsWithSegments("/Error")
                || path.StartsWithSegments("/not-found")
                || path.StartsWithSegments("/kiln-status"))
            {
                return null;
            }

            return InteractiveServer;
        }
    }
}
